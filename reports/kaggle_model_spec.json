{
  "checkpoint": "models/market_parametric_pinn_kaggle.pt",
  "training_run": "juhilmodi/nse-pinn-market-training v2",
  "architecture": {
    "hidden": 128,
    "depth": 5,
    "input": ["spot_over_strike", "tau_over_maturity", "sigma_normalized", "rate_normalized", "maturity_normalized", "option_code"],
